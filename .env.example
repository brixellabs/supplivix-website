# Root Environment Configuration Template
# Copy to .env for local environment

# Database Configuration (Neon Serverless PostgreSQL)
# Use pooled connection string (with -pooler in host) for application runtime
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require
# Use direct connection string (without -pooler) for migrations
DIRECT_DATABASE_URL=postgresql://user:password@ep-sample.region.neon.tech/neondb?sslmode=require

# Django Core Settings
SECRET_KEY=django-insecure-replace-this-with-a-secure-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:5173

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloudflare Turnstile Bot Protection (official test key provided below)
# Test site key: 1x00000000000000000000AA (always passes)
# Test secret key: 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Initial Staff Credentials for Demo Seeding
DEMO_STAFF_EMAIL=admin@supplivix.com
DEMO_STAFF_PASSWORD=SupplivixAdmin2026!
